---
interface Props {
  title?: string
  description?: string
}
const { title = 'The Three Edit', description = '' } = Astro.props
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Almarai:wght@300;400;700&display=swap" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>

  <nav class="nav" role="navigation" aria-label="Main navigation">
    <div class="nav__inner">
      <a href="/" class="nav__logo">the three edit</a>
      <ul class="nav__links">
        <li><a href="/rooms/">Rooms</a></li>
        <li><a href="/products/">Products</a></li>
        <li><a href="/about/">About</a></li>
      </ul>
    </div>
  </nav>

  <slot />

  <footer class="footer">
    <div class="footer__inner">
      <span class="footer__logo">the three edit</span>
      <nav class="footer__links">
        <a href="/rooms/">Rooms</a>
        <a href="/products/">Products</a>
        <a href="/about/">About</a>
        <a href="https://www.instagram.com/thethree.edit/" target="_blank" rel="noopener">Instagram</a>
      </nav>
      <p class="footer__tagline">slow living, carefully found.</p>
    </div>
  </footer>

  <script src="/js/main.js" defer></script>
</body>
</html>
