---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="The Three Edit — slow living, carefully found.">

  <section class="hero">
    <div class="hero__image">
      <img id="hero-img" src="/images/hero/hero.webp" alt="The Three Edit — slow living, carefully found." />
    </div>
    <div class="hero__text">
      <span class="label">slow living, carefully found.</span>
      <h1 id="hero-headline">Find the feeling<br>of a room.</h1>
      <p id="hero-subhead">Curated finds, room recipes, and everyday details that make a space feel more beautiful, useful, and lived-in.</p>
      <a href="/rooms/" class="btn btn--filled">explore the rooms</a>
    </div>
  </section>

  <section class="section section--centered" id="how-we-curate">
    <div class="container">
      <div class="section-header">
        <span class="label">the approach</span>
        <h2 id="curate-title">The edit, in three steps</h2>
      </div>
      <ol class="steps" id="steps-list"></ol>
    </div>
  </section>

  <section class="section" id="products">
    <div class="container">
      <div class="section-header">
        <span class="label">the edit</span>
        <h2 id="products-title">Carefully found things</h2>
        <p id="products-desc">Each one chosen for how it feels, not just how it looks.</p>
      </div>
      <div class="grid-3" id="featured-products"></div>
      <div style="margin-top: var(--space-lg); text-align: center;">
        <a href="/products/" class="btn btn--accent">view all products</a>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="rooms">
    <div class="container">
      <div class="section-header">
        <span class="label">room recipes</span>
        <h2 id="rooms-title">Shop the feeling of a space</h2>
        <p id="rooms-desc">Not just the objects — the mood, the texture, the whole arrangement.</p>
      </div>
      <div class="grid-2" id="featured-rooms"></div>
      <div style="margin-top: var(--space-lg); text-align: center;">
        <a href="/rooms/" class="btn btn--accent">view all rooms</a>
      </div>
    </div>
  </section>

  <section class="section section--centered" id="about">
    <div class="container">
      <div style="max-width: 640px; margin-inline: auto;">
        <span class="label">the story</span>
        <h2>About Melody</h2>
        <div class="about-intro" style="margin-top: var(--space-md);">
          <p>"I'm drawn to the search for beautiful things. Not collecting for the sake of it — but the quiet pleasure of finding something that feels exactly right, and understanding why."</p>
        </div>
        <a href="/about/" class="btn">read more</a>
      </div>
    </div>
  </section>

  <section class="section section--alt section--centered" id="instagram">
    <div class="container">
      <div class="section-header">
        <span id="instagram-handle" class="label">@thethree.edit</span>
        <h2 id="instagram-title">Follow along</h2>
      </div>
      <div class="grid-3 instagram-grid" id="instagram-grid"></div>
      <div class="instagram-cta">
        <p id="instagram-desc">More finds, daily details, and room moments</p>
        <a href="https://www.instagram.com/thethree.edit/" target="_blank" rel="noopener" class="btn">follow @thethree.edit</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script is:inline>
  function setText(id, val) {
    if (val) document.getElementById(id).textContent = val;
  }

  async function loadHome() {
    const [roomsRes, productsRes, contentRes, textRes] = await Promise.all([
      fetch('/api/rooms'),
      fetch('/api/products'),
      fetch('/api/content'),
      fetch('/api/text').catch(() => null),
    ]);

    const rooms    = await roomsRes.json();
    const products = await productsRes.json();
    const content  = await contentRes.json();
    const text     = textRes ? await textRes.json().catch(() => ({})) : {};
    const hp       = content.homepage;
    const t        = key => text[key]?.text || '';

    injectSEO(
      (t('hp_01_hero_02_headline') || hp.heroHeadline || 'The Three Edit') + ' — The Three Edit',
      text['hp_01_hero_02_headline']?.seoDescription || '',
      text['hp_01_hero_00_image']?.mediaUrl || ''
    );

    const mediaUrl = text['hp_01_hero_00_image']?.mediaUrl || hp.heroImage || '';
    if (mediaUrl) {
      const heroImg = document.getElementById('hero-img');
      if (/\.mp4(\?|$)/i.test(mediaUrl)) {
        const video = document.createElement('video');
        video.src = mediaUrl;
        video.autoplay = true; video.loop = true; video.muted = true; video.playsInline = true;
        video.style.cssText = 'width:100%;height:100%;object-fit:cover;';
        heroImg.replaceWith(video);
      } else {
        heroImg.src = mediaUrl;
      }
    }

    const heroLabel = t('hp_01_hero_01_label');
    if (heroLabel) document.querySelector('.hero .label').textContent = heroLabel;
    setText('hero-headline', t('hp_01_hero_02_headline') || hp.heroHeadline);
    setText('hero-subhead',  t('hp_01_hero_03_subheadline') || hp.heroSubhead);
    const heroCta = t('hp_01_hero_04_cta');
    if (heroCta) document.querySelector('.hero .btn--filled').textContent = heroCta;

    const approachLabel = t('hp_02_approach_01_label');
    if (approachLabel) document.querySelector('#how-we-curate .label').textContent = approachLabel;
    setText('curate-title', t('hp_02_approach_02_headline') || hp.howWeWorkTitle);

    const stepsList = document.getElementById('steps-list');

    const stepData = [
      {
        number: t('hp_02_approach_03_nr_1'),
        label:  t('hp_02_approach_04_stepname_1'),
        body:   t('hp_02_approach_05_step_1'),
      },
      {
        number: t('hp_02_approach_03_nr_2'),
        label:  t('hp_02_approach_04_stepname_2'),
        body:   t('hp_02_approach_05_step_2'),
      },
      {
        number: t('hp_02_approach_03_nr_3'),
        label:  t('hp_02_approach_04_stepname_3'),
        body:   t('hp_02_approach_05_step_3'),
      },
    ];

    const fallback = hp.howWeWorkSteps || [];
    const fallbackNums = ['01', '02', '03'];

    stepData.forEach((step, idx) => {
      const li = document.createElement('li');
      li.className = 'steps__item';

      const number = step.number || fallbackNums[idx];
      const label  = step.label  || '';
      const body   = step.body   || fallback[idx] || '';

      const numEl = document.createElement('span');
      numEl.className = 'steps__number';
      numEl.textContent = number;
      li.appendChild(numEl);

      if (label) {
        const labelEl = document.createElement('span');
        labelEl.className = 'steps__label';
        labelEl.textContent = label;
        li.appendChild(labelEl);
      }

      const p = document.createElement('p');
      p.textContent = body;
      li.appendChild(p);

      stepsList.appendChild(li);
    });

    const roomsLabel = t('hp_03_rooms_01_label');
    if (roomsLabel) document.querySelector('#rooms .label').textContent = roomsLabel;
    setText('rooms-title', t('hp_03_rooms_02_headline')    || hp.roomsTitle);
    setText('rooms-desc',  t('hp_03_rooms_03_subheadline') || hp.roomsDescription);

    const productsLabel = t('hp_04_products_01_label');
    if (productsLabel) document.querySelector('#products .label').textContent = productsLabel;
    setText('products-title', t('hp_04_products_02_headline')    || hp.productsTitle);
    setText('products-desc',  t('hp_04_products_03_subheadline') || hp.productsDescription);

    setText('instagram-handle', t('hp_05_social_01_label')       || hp.instagramHandle);
    setText('instagram-title',  t('hp_05_social_02_headline')    || hp.instagramTitle);
    setText('instagram-desc',   t('hp_05_social_03_subheadline') || hp.instagramDescription);
    const socialCta = t('hp_05_social_04_cta');
    if (socialCta) document.querySelector('.instagram-cta .btn').textContent = socialCta;

    const aboutLabel = t('hp_06_about_01_label');
    if (aboutLabel) document.querySelector('#about .label').textContent = aboutLabel;
    const aboutHeadline = t('hp_06_about_02_headline');
    if (aboutHeadline) document.querySelector('#about h2').textContent = aboutHeadline;
    const aboutBody = t('hp_06_about_03_body');
    if (aboutBody) document.querySelector('#about .about-intro p').textContent = aboutBody;
    const aboutCta = t('hp_06_about_04_cta');
    if (aboutCta) document.querySelector('#about .btn').textContent = aboutCta;

    setText('footer-tagline', t('gl_02_footer_01_tagline') || hp.footerTagline);

    const roomsEl = document.getElementById('featured-rooms');
    rooms.slice(0, 3).forEach(room => {
      roomsEl.insertAdjacentHTML('beforeend', `
        <a class="card" href="/rooms/${esc(room.slug)}/">
          <div class="card__image">${slideshowHtml(room.images, false, room.altText)}</div>
          <div class="card__overlay">
            <p class="card__name">${esc(room.title)}</p>
            <p class="card__desc">${esc(room.description)}</p>
            <span class="card__link">explore →</span>
          </div>
        </a>
      `);
    });

    const productsEl = document.getElementById('featured-products');
    products.slice(0, 6).forEach(p => {
      productsEl.insertAdjacentHTML('beforeend', `
        <a class="card" href="/products/${esc(p.slug)}/">
          <div class="card__image">${slideshowHtml(p.images, false, p.altText)}</div>
          <div class="card__overlay">
            <p class="card__name">${esc(p.title)}</p>
            <p class="card__desc">${esc(p.description)}</p>
            <span class="card__link">shop the edit →</span>
          </div>
        </a>
      `);
    });

    initSlideshows();
  }

  loadHome();
</script>
