---
import BaseLayout from '../../layouts/BaseLayout.astro'
---
<BaseLayout title="Products — The Three Edit">

  <main>
    <div class="container">
      <div class="page-hero">
        <span class="label">the edit</span>
        <h1>All Products</h1>
        <p>Carefully found things. Each one chosen for how it feels to live with.</p>
      </div>

      <div class="filter-bar" id="filter-bar" role="group" aria-label="Filter products"></div>
      <div class="grid-3" id="products-grid"></div>
    </div>
  </main>

</BaseLayout>

<script is:inline>
  const active = { style: 'all', color: 'all' };

  function applyFilter() {
    document.querySelectorAll('[data-style][data-color]').forEach(card => {
      const styles = card.dataset.style ? card.dataset.style.split(',') : [];
      const colors = card.dataset.color ? card.dataset.color.split(',') : [];
      const matchStyle = active.style === 'all' || styles.includes(active.style);
      const matchColor = active.color === 'all' || colors.includes(active.color);
      card.classList.toggle('hidden', !(matchStyle && matchColor));
    });
  }

  function buildFilters(products) {
    const styles = [...new Set(products.flatMap(p => p.style))].sort();
    const colors = [...new Set(products.flatMap(p => p.color))].sort();

    function groupHtml(label, group, values) {
      const allBtn = `<button class="filter-btn active" data-group="${group}" data-value="all">All</button>`;
      const btns = values.map(v =>
        `<button class="filter-btn" data-group="${group}" data-value="${esc(v)}">${esc(v)}</button>`
      ).join('');
      return `<div class="filter-group"><span class="filter-group__label">${label}</span>${allBtn}${btns}</div>`;
    }

    document.getElementById('filter-bar').innerHTML =
      groupHtml('Style', 'style', styles) + groupHtml('Colour', 'color', colors);

    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.dataset.group;
        active[group] = btn.dataset.value;
        document.querySelectorAll(`.filter-btn[data-group="${group}"]`)
          .forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilter();
      });
    });
  }

  Promise.all([
    fetch('/api/products'),
    fetch('/api/text').catch(() => null),
  ]).then(async ([productsRes, textRes]) => {
    const products = await productsRes.json();
    const text     = textRes ? await textRes.json().catch(() => ({})) : {};
    const t        = key => text[key]?.text || '';

    injectSEO(
      (t('pr_01_products_02_headline') || 'Products') + ' — The Three Edit',
      text['pr_01_products_02_headline']?.seoDescription || ''
    );

    const label = t('pr_01_products_01_label');
    if (label) document.querySelector('.page-hero .label').textContent = label;
    const headline = t('pr_01_products_02_headline');
    if (headline) document.querySelector('.page-hero h1').textContent = headline;
    const subhead = t('pr_01_products_03_subheadline');
    if (subhead) document.querySelector('.page-hero p').textContent = subhead;

    buildFilters(products);

    const grid = document.getElementById('products-grid');
    products.forEach(p => {
      grid.insertAdjacentHTML('beforeend', `
        <a class="card" href="/products/${esc(p.slug)}/"
           data-style="${esc(p.style.join(','))}" data-color="${esc(p.color.join(','))}">
          <div class="card__image">${slideshowHtml(p.images, false, p.altText)}</div>
          <div class="card__overlay">
            <p class="card__name">${esc(p.title)}</p>
            <p class="card__desc">${esc(p.description)}</p>
            <span class="card__link">shop the edit →</span>
          </div>
        </a>
      `);
    });

    initSlideshows();
  });
</script>
